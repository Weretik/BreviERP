  },
  "Identity": {
    "AdminUser": {
      "Email": "vitaliythupin@gmail.com",
      "FullName": "Адміністратор системи",
      "LockoutEnabled": true
    },
    "CookieSession": {
      "CookieName": "__Host-brevi.session",
      "LifetimeDays": 7,
      "SecurityStampValidationMinutes": 5,
      "RequireSecure": true
    },
    "SessionCookies": {
      "CsrfCookieName": "brevi.csrf",
      "CsrfHeaderName": "X-CSRF-Token",
      "CsrfCookiePath": "/",
      "CsrfCookieDomain": "",
      "CsrfCookieTtlDays": 14,
      "Secure": true,
      "SameSite": "Lax"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Process"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentName",
      "WithEnvironmentUserName",
      "WithProcessId",
      "WithProcessName"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://office.brevi.com.ua",
      "https://www.office.brevi.com.ua",
      "https://brevi-web.pages.dev"
    ]
  },
