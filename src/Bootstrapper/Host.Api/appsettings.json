    "Login": "",
    "Password": "",
    "PublicBaseUrl": "https://brevi-media.cdn.express"
  },
  "MediaUpload": {
    "MaxFileSizeBytes": 15728640,
    "BaseFolder": "/library/original",
    "ThumbnailFolder": "/library/thumbs",
    "ThumbnailMaxSize": 480
  },
  "Reminders": {
    "Telegram": {
      "BotToken": "",
      "WebhookSecret": "",
      "WebhookUrl": ""
    }
  },
  "TrustedProxy": {
    "ClientIpHeaderName": "X-Brevi-Client-IP",
    "SecretHeaderName": "X-Brevi-Proxy-Secret",
    "SharedSecret": ""
