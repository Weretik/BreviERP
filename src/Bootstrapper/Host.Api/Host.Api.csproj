<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <UserSecretsId>33d6b29b-be63-449a-8f2d-2a12c0731327</UserSecretsId>
        <!-- Every build writes the OpenAPI document of the code to docs/sdd/contracts/openapi.json (ADR-0015); the
             container image build skips it. -->
        <OpenApiGenerateDocuments Condition="'$(DOTNET_RUNNING_IN_CONTAINER)' != 'true'">true</OpenApiGenerateDocuments>
        <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../../docs/sdd/contracts</OpenApiDocumentsDirectory>
        <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
    </PropertyGroup>

    <ItemGroup>
